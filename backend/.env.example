# LLM Provider - choose one
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
OPENROUTER_API_KEY=your-key-here

# Which provider to use: "openai", "anthropic", or "openrouter"
LLM_PROVIDER=openrouter

# Model to use (OpenRouter free tier examples): 
#   deepseek/deepseek-r1:free
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
#   openai/gpt-oss-120b:free
LLM_MODEL=openai/gpt-oss-120b:free

# Frontend URL for CORS (several allowed, comma-separated)
FRONTEND_URL=http://localhost:5173

# Research logs - Supabase (Project Settings -> API). Leave empty to save JSON files locally in backend/logs/
SUPABASE_URL=
SUPABASE_KEY=

# /api/run executes Python on the server. Keep false when deployed publicly.
CODE_EXECUTION_ENABLED=false
